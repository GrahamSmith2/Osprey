# Everything in results/ is tracked, including the .mat simulation data
# (~49 MB total, largest single file 24 MB — within GitHub's limits) so that
# results can be inspected without re-running the analyses.

*.asv
*.autosave
slprj/

# Python: per-run output from `python -m osprey run` is scratch; the tracked
# results are results/python/, written by `python -m osprey report`.
python/runs/
__pycache__/
.pytest_cache/
